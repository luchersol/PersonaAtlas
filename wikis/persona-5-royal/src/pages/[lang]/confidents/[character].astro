---
import Layout from '@layouts/Layout.astro';
import { useTranslations, getConfident } from '@i18n/utils';
import type { DefaultParams, P5Confidant } from '@types2/p5';
import ConfidentTable from '@components/ConfidentTable.astro';
import NavButton from '@components/NavButton.astro';
import { LANGUAGES } from '@i18n/utils';


export async function getStaticPaths() {
  const CONFIDENTS = [
    "0-igor",
    "1-morgana",
    "2-makoto",
    "3-haru",
    "4-yusuke",
    "5-sojiro",
    "6-ann",
    "7-ryuji",
    "8-goro",
    "9-futaba",
    "10-chihaya",
    "11-caroline-justine",
    "12-iwai",
    "13-tae",
    "14-kawakami",
    "15-ohya",
    "16-shinya",
    "17-hifumi",
    "18-mishima",
    "19-yoshida",
    "20-sae",
    "21-kasumi",
    "22-maruki"
  ]
  const paths: any[] = [];

  for (const lang of LANGUAGES) {
    for (const confidentId of CONFIDENTS) {
      const confident = await getConfident(lang, confidentId);
      paths.push({
        params: { character: confident.id, lang },
        props: { char: confident}
      })
    }
  }

  return paths;
}


const { lang } = Astro.params as DefaultParams; 
const char: P5Confidant = Astro.props.char;

const t = useTranslations(lang);
---

<Layout title={`${char.name} Profile | P5`}>
    <NavButton lang={lang} route="/confidents">
        {t("confidents.[character].back")}
    </NavButton>

    <div class="p5-profile-layout">

        <aside class="p5-profile-sidebar">
            <div class="p5-profile-header">
                <div class="p5-big-avatar">
                    <img
                        src={`/images/characters/${char.id}.jpg`}
                        alt={char.name}
                        onerror="this.style.backgroundColor='#222'"
                    />
                </div>

                <div class="p5-big-arcana">
                    <img
                        src={`/images/cards/${char.arcana.id}.jpg`}
                        alt={char.arcana.name}
                        onerror="this.style.display='none'"
                    />

                    <div class="p5-arcana-title-badge">
                        {char.arcana.name}
                    </div>
                </div>
            </div>

            <div class="p5-meta-box">
                <h3><img src="/images/gift.png" color="white"/> {t("confidents.[character].gift-title")}</h3>

                {char.gifts?.length ? (
                    <ul class="p5-gift-list">
                        {char.gifts.map(gift => (
                            <li>{gift}</li>
                        ))}
                    </ul>
                ) : (
                    <p class="p5-no-gifts">
                        {t("confidents.[character].no-gift")}
                    </p>
                )}
            </div>

        </aside>

        <section class="p5-profile-details">

            <h1 class="p5-title">{char.name}</h1>

            <ConfidentTable
                ranks={char.ranks}
                lang={lang}
            />

        </section>

    </div>
</Layout>

<style>
  .p5-profile-layout{
    display:grid;
    grid-template-columns:280px 1fr;
    gap:2rem;

    background:#111;
    border:4px solid var(--primary);
    box-shadow:8px 8px 0 #000;

    margin-top:1.5rem;
    padding:2rem;
}

.p5-profile-sidebar{
    display:flex;
    flex-direction:column;
    gap:1.5rem;
}

.p5-big-avatar{
    width:100%;
    aspect-ratio:1;
    border:4px solid white;
    overflow:hidden;
    transform:rotate(-2deg);
}

.p5-big-avatar img{
    width:100%;
    height:100%;
    object-fit:cover;
}

.p5-big-arcana {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
}

.p5-big-arcana img{
    max-width:110px;
}

.p5-arcana-title-badge{
    margin-top:.5rem;
    background:var(--primary);
    color:black;
    display:inline-block;
    padding:.35rem .8rem;
    font-family:Impact,sans-serif;
    transform:skewX(-10deg);
}

.p5-profile-details{
    display:flex;
    flex-direction:column;
    gap:1.5rem;
}

.p5-title{
    margin:0;
}

.p5-meta-box{
    background:#1b1b1b;
    border-left:4px solid var(--primary);
    padding:1rem;
}

.p5-meta-box h3{
    margin:0 0 .75rem;
    color:var(--primary);
}

.p5-gift-list{
    margin:0;
    padding-left:1rem;
}

.p5-gift-list li+li{
    margin-top:.35rem;
}

.p5-profile-header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
}

/* ===========================
   Móvil
=========================== */

@media (max-width:768px){

    .p5-profile-layout{
        grid-template-columns:1fr;
        padding:1rem;
        gap:1.5rem;
    }

    .p5-profile-sidebar{
        align-items:center;
    }

    .p5-big-avatar{
        width:160px;
    }

    .p5-big-arcana img{
        max-width:80px;
    }

    .p5-arcana-title-badge{
        font-size:.9rem;
    }

    .p5-profile-details{
        gap:1rem;
    }

    .p5-profile-header {
        flex-direction: row;
        justify-content: center;
        align-items: flex-start;
        gap: 1rem;
    }
}

</style>