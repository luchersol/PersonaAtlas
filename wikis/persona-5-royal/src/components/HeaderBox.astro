---

import NoteBox from './NoteBox.astro';


interface Props {
  title: string; // Asegúrate de que no diga "never" o un tipo incompatible
  subtitle: string;
  description?: string;
  mechanic?: string;
}

const {title, subtitle, description, mechanic} = Astro.props;

---

<header class="p5-page-header">
    <div class="p5-header-content">
        <div class="p5-header-text">
            <h1 class="p5-title">{title}</h1>
            <p class="p5-subtitle">{subtitle}</p>
        </div>
        {
           description && mechanic && <NoteBox {...{description, mechanic}} />
        }
    </div>
</header>

<style>
    .p5-page-header {
        border-left: 8px solid var(--primary);
        padding-left: 1.5rem;
    }

    .p5-header-content {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .p5-header-text {
        flex: 1;
    }

    .p5-subtitle {
        font-size: 1.2rem;
        color: var(--primary);
        text-transform: uppercase;
        font-weight: 700;
        margin-top: 0.5rem;
    }
</style>