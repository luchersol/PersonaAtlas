---
interface Props {
    id: string;
    title?: string;
}

const { id, title } = Astro.props;
---

<dialog id={id} class="p5-dialog">
    <div class="p5-dialog-content">

        {title && (
            <header class="p5-dialog-header">
                <h2>{title}</h2>

                <button
                    class="p5-dialog-close"
                    onclick={`document.getElementById('${id}').close()`}
                >
                    ✕
                </button>
            </header>
        )}

        <slot />

    </div>
</dialog>

<style>
.p5-dialog {
    margin: auto;
    padding: 0;
    border: none;
    background: transparent;
}

.p5-dialog::backdrop {
    background: rgba(0,0,0,.75);
    backdrop-filter: blur(4px);
}

.p5-dialog-content {
    width: min(700px, 90vw);

    background: var(--surface);

    border: 3px solid var(--primary);

    box-shadow: var(--shadow);

    padding: 2rem;
}

.p5-dialog-header {
    display: flex;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 1.5rem;
}

.p5-dialog-close {
    cursor: pointer;

    border: none;
    background: transparent;

    color: white;

    font-size: 1.4rem;
}
</style>