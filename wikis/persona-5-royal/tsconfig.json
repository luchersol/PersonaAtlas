{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", 
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.astro",
    "**/*"
  ],
  "exclude": ["dist"],
  "compilerOptions": {
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@layouts/*": [
        "./src/layouts/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@i18n/*": [
        "./src/i18n/*"
      ],
      "@types2/*": [
        "./src/types/*"
      ],
      "@styles2/*": [
        "./src/styles/*"
      ],
    }
  }
}
