---
// src/components/NavPersona4.astro
import { useTranslations } from '@i18n/utils';
import NavLink from './NavLink.astro';
import type { DefaultParams } from '@types2/p4';

interface Props {}

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;

const t = useTranslations(lang);

const navItems = [
  { id: 'social-links', concept: t("nav.concept.social-link") },
  { id: 'velvet-room', concept: t("nav.concept.velvet-room") },
  { id: 'midnight-channel', concept: t("nav.concept.midnight-channel") },
  { id: 'tv-world', concept: t("nav.concept.tv-world") },
  { id: 'quests', concept: t("nav.concept.quests") }
];
---

<nav class="p4-navbar">
  <div class="p4-logo">
    P4_MENU.SYS
  </div>
  
  <div class="p4-links-container">
    {navItems.map((item) => (
      <NavLink href={`/${lang}/${item.id}`} concept={item.concept} />
    ))}
  </div>
</nav>

<style>
  .p4-navbar {
    background-color: #111;
    padding: 1.5rem;
    border-bottom: 4px solid var(--primary);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    justify-content: center;
  }

  .p4-logo {
    color: var(--primary);
    font-family: 'Impact', sans-serif;
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: -0.05em;
    transform: skewX(-12deg);
    background-color: var(--background);
    padding: 0.25rem 0.75rem;
    border: 2px solid var(--primary);
    margin-right: 1rem;
  }

  .p4-links-container {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>