---

interface Props {
  title: string; // Asegúrate de que no diga "never" o un tipo incompatible
  subtitle: string;
}

const {title, subtitle} = Astro.props;
---

<header class="p4-page-header">
    <h1 class="p4-title">{title}</h1>
    <p class="p4-subtitle">{subtitle}</p>
</header>

<style>
    .p4-page-header { border-left: 8px solid #FFEB3B; padding-left: 1.5rem; }
    .p4-subtitle { font-size: 1.2rem; color: #FFEB3B; text-transform: uppercase; font-weight: 700; margin-top: -0.5rem; }
</style>