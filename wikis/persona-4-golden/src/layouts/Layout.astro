---
// src/layouts/Layout.astro
import LangSelector from '@components/LangSelector.astro';
import NavPersona4 from '../components/NavPersona4.astro';

const { title = "Persona 4 Hub" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        
        <!-- Fuentes de Google -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Impact&family=Outfit:wght@400;700;900&display=swap" rel="stylesheet">
    </head>
    
    <body>
        <!-- El fondo de líneas diagonales retro -->
        <div class="p4-background-lines"></div>
        
        <!-- El bloque amarillo de la esquina -->
        <div class="p4-corner-block"></div>
        
        <header>
            <NavPersona4 />
            <LangSelector />
        </header>
        
        <main class="p4-main-content">
            <slot />
        </main>

        <footer class="p4-footer">
            <span class="yellow-text">© ATLUS</span> // EVERY DAY'S GREAT AT YOUR JUNES!
        </footer>
    </body>
</html>

<style is:global>
    /* RESET BASE Y CONFIGURACIÓN P4 */
    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        min-height: 100%;
    }

    body {
        background-color: #1a1a1a;
        color: #ffffff;
        font-family: 'Outfit', sans-serif;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        position: relative;
        overflow-x: hidden;
    }

    /* TEXTO SELECCIONADO AL ARRASTRAR EL RATÓN */
    ::selection {
        background-color: #FFEB3B;
        color: #000;
    }

    /* EFECTOS DE FONDO */
    .p4-background-lines {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0.04;
        z-index: 0;
        background-image: linear-gradient(45deg, #888 25%, transparent 25%, transparent 50%, #888 50%, #888 75%, transparent 75%, transparent);
        background-size: 40px 40px;
    }

    .p4-corner-block {
        position: fixed;
        bottom: -5rem;
        right: -5rem;
        width: 20rem;
        height: 20rem;
        background-color: #FFEB3B;
        transform: rotate(12deg);
        pointer-events: none;
        z-index: 0;
        box-shadow: 10px 10px 0px 0px #000;
    }

    /* CONTENEDOR PRINCIPAL */
    .p4-main-content {
        flex: 1 0 auto;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem;
        position: relative;
        z-index: 1;
        animation: p4FadeIn 0.3s ease-out forwards;
    }

    /* FOOTER */
    .p4-footer {
        position: relative;
        z-index: 1;
        background-color: #000;
        color: #666;
        padding: 1rem;
        text-align: center;
        font-size: 0.75rem;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border-top: 2px solid #222;
    }

    .yellow-text {
        color: #FFEB3B;
    }

    /* CLASES UTILIDADES PARA TUS PÁGINAS (Úsalas en tus h1, h2, etc) */
    .p4-title {
        font-family: 'Impact', sans-serif;
        text-transform: uppercase;
        letter-spacing: -0.02em;
        transform: skewX(-10deg);
        color: #FFEB3B;
        text-shadow: 4px 4px 0px #000;
        font-size: 3rem;
        margin-bottom: 1rem;
    }

    /* ANIMACIÓN */
    @keyframes p4FadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Ocultar bloque en pantallas muy pequeñas para evitar scroll raro */
    @media (max-width: 768px) {
        .p4-corner-block {
            display: none;
        }
    }
</style>