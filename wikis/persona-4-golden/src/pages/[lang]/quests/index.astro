---
import type { P4Quest, Params } from '@types2/p4.ts';

import Layout from '@layouts/Layout.astro';
import { useTranslations, getP4Data, getQuestsList } from '@i18n/utils';
import HeaderBox from '@components/HeaderBox.astro';
import QuestBox from '@components/QuestBox.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as Params;

const t = useTranslations(lang);

// ⚡️ ¡Simplemente añadimos await a las llamadas!
const questsList = await getQuestsList(lang);

const info = await getP4Data(lang, 'quests');

if (!info) {
  throw new Error(`Data missing for velvet-room in language: ${lang}`);
}

---
<Layout title={`${info.title} | Persona 4 Hub`}>
  <article class="p4-card-container">
    <HeaderBox {...info} />

    <section class="p4-quests-section">
      <div class="p4-quests-header">
        <h2 class="p4-title sub text-orange">{t("quests.board")}</h2>

        <form class="p4-quest-jump-form" data-quest-jump-form data-lang={lang}>
          <label class="p4-quest-jump-label" for="quest-id">Quest ID</label>
          <div class="p4-quest-jump-controls">
            <input
              id="quest-id"
              class="p4-quest-jump-input"
              name="quest-id"
              type="number"
              inputmode="numeric"
              min="1"
              placeholder="12"
            />
            <button class="p4-quest-jump-btn" type="submit"><span>Go</span></button>
          </div>
        </form>
      </div>

      <div class="p4-quests-list">
        {questsList.map((quest: P4Quest) => (
          <QuestBox {...quest} />
        ))}
      </div>
    </section>

    <a href="/" class="p4-back-btn"><span>{t("nav.back")}</span></a>
  </article>
</Layout>

<script>
  const questJumpForm = document.querySelector('[data-quest-jump-form]');

  questJumpForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const input = questJumpForm.querySelector<HTMLInputElement>('input[name="quest-id"]');
    const value = input?.value?.trim();
    const lang = questJumpForm.getAttribute('data-lang');

    if (!value || !lang) return;

    window.location.assign(`/${lang}/quests/${encodeURIComponent(value)}`);
  });
</script>

<style>
  /* Aquí van los estilos base que ya teníamos para tarjetas compartidas */
  .p4-card-container { display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem; }
  .p4-page-header { border-left: 8px solid #FFEB3B; padding-left: 1.5rem; }
  .p4-subtitle { font-size: 1.2rem; color: #FFEB3B; text-transform: uppercase; font-weight: 700; margin-top: -0.5rem; }
  .p4-content-box { background-color: #000; border: 3px solid #333; padding: 2.5rem; box-shadow: 8px 8px 0px 0px #000; }
  .p4-description { font-size: 1.15rem; line-height: 1.8; color: #e0e0e0; }
  .p4-mechanic-box { margin-top: 2rem; background-color: #222; border-left: 5px solid #FFEB3B; padding: 1.5rem; position: relative; }
  .p4-badge { position: absolute; top: -12px; left: 15px; background-color: #FFEB3B; color: #000; font-family: 'Impact', sans-serif; padding: 2px 8px; font-size: 0.85rem; transform: skewX(-10deg); }
  .p4-mechanic-box p { font-size: 1rem; color: #FFEB3B; font-style: italic; }
  .p4-back-btn { display: inline-block; align-self: flex-start; background-color: #333; color: #fff; padding: 0.6rem 1.5rem; font-weight: 700; text-transform: uppercase; text-decoration: none; transform: skewX(-12deg); border: 2px solid #444; margin-top: 0.5rem; position: relative; z-index: 1; }
  .p4-back-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-back-btn:hover { background-color: #fff; color: #000; border-color: #fff; }

  .p4-quests-section {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 100%;
  }

  .p4-quests-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .p4-quest-jump-form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: min(100%, 16rem);
    padding: 0.6rem 0.75rem;
    background-color: #111;
    border: 2px solid #333;
    box-shadow: 4px 4px 0 #000;
  }

  .p4-quest-jump-label {
    font-size: 0.7rem;
    color: #FF9800;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .p4-quest-jump-controls {
    display: flex;
    gap: 0.4rem;
  }

  .p4-quest-jump-input {
    flex: 1;
    background-color: #000;
    color: #fff;
    border: 2px solid #444;
    padding: 0.45rem 0.6rem;
    font-size: 0.95rem;
    outline: none;
    width: 6rem;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .p4-quest-jump-input::-webkit-outer-spin-button,
  .p4-quest-jump-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .p4-quest-jump-input:hover {
    border-color: #FF9800;
  }

  .p4-quest-jump-input:focus {
    border-color: #FF9800;
    box-shadow: 0 0 0 2px rgba(255, 152, 0, 0.25);
  }

  .p4-quest-jump-btn {
    background-color: #FF9800;
    color: #000;
    border: 2px solid #333;
    padding: 0.4rem 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transform: skewX(-12deg);
    font-size: 0.85rem;
  }

  .p4-quest-jump-btn span {
    display: inline-block;
    transform: skewX(12deg);
  }

  .p4-quest-jump-btn:hover {
    background-color: #fff;
  }

  /* Paleta naranja característica de menús secundarios de P4 */
  .text-orange { color: #FF9800 !important; }
  .border-orange { border-color: #FF9800 !important; }
  .border-orange-left { border-left-color: #FF9800 !important; }
  .bg-orange { background-color: #FF9800 !important; color: #000 !important; }

  /* Grid de misiones */
  .p4-quests-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

</style>