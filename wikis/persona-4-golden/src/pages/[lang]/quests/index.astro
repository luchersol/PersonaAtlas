---
import type { P4Quest, DefaultParams } from '@types2/p4.ts';

import Layout from '@layouts/Layout.astro';
import { useTranslations, getP4Data, getQuestsList } from '@i18n/utils';
import HeaderBox from '@components/HeaderBox.astro';
import QuestBox from '@components/QuestBox.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';
import Section from '@components/Section.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;

const t = useTranslations(lang);

// ⚡️ ¡Simplemente añadimos await a las llamadas!
const questsList = await getQuestsList(lang);

const info = await getP4Data(lang, 'quests');

if (!info) {
  throw new Error(`Data missing for velvet-room in language: ${lang}`);
}

---
<Layout title={`${info.title} | Persona 4 Hub`}>
  <Page>
    <HeaderBox {...info} />

    <Section>
      <div class="p4-quests-header">
        <h2 class="p4-title sub text-orange">{t("quests.board")}</h2>

        <form class="p4-quest-jump-form" data-quest-jump-form data-lang={lang}>
          <label class="p4-quest-jump-label" for="quest-id">Quest ID</label>
          <div class="p4-quest-jump-controls">
            <input
              id="quest-id"
              class="p4-quest-jump-input"
              name="quest-id"
              type="number"
              inputmode="numeric"
              min="1"
              placeholder="12"
            />
            <button class="p4-quest-jump-btn" type="submit"><span>Go</span></button>
          </div>
        </form>
      </div>

      <div class="p4-quests-list">
        {questsList.map((quest: P4Quest) => (
          <QuestBox {...quest} />
        ))}
      </div>
    </Section>

    <NavButton {lang} route="/" >{t("nav.back")}</NavButton>
  </Page>
</Layout>

<script>
  const questJumpForm = document.querySelector('[data-quest-jump-form]');

  questJumpForm?.addEventListener('submit', (event) => {
    event.preventDefault();

    const input = questJumpForm.querySelector<HTMLInputElement>('input[name="quest-id"]');
    const value = input?.value?.trim();
    const lang = questJumpForm.getAttribute('data-lang');

    if (!value || !lang) return;

    window.location.assign(`/${lang}/quests/${encodeURIComponent(value)}`);
  });
</script>

<style>
  .p4-quests-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .p4-quest-jump-form {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    width: min(100%, 16rem);
    padding: 0.6rem 0.75rem;
    background-color: #111;
    border: 2px solid #333;
    box-shadow: 4px 4px 0 var(--background);
  }

  .p4-quest-jump-label {
    font-size: 0.7rem;
    color: var(--color-orange);
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 700;
  }

  .p4-quest-jump-controls {
    display: flex;
    gap: 0.4rem;
  }

  .p4-quest-jump-input {
    flex: 1;
    background-color: var(--background);
    color: #fff;
    border: 2px solid #444;
    padding: 0.45rem 0.6rem;
    font-size: 0.95rem;
    outline: none;
    width: 6rem;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .p4-quest-jump-input::-webkit-outer-spin-button,
  .p4-quest-jump-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .p4-quest-jump-input:hover {
    border-color: var(--color-orange);
  }

  .p4-quest-jump-input:focus {
    border-color: var(--color-orange);
    box-shadow: 0 0 0 2px rgba(255, 152, 0, 0.25);
  }

  .p4-quest-jump-btn {
    background-color: var(--color-orange);
    color: var(--background);
    border: 2px solid #333;
    padding: 0.4rem 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    cursor: pointer;
    transform: skewX(-12deg);
    font-size: 0.85rem;
  }

  .p4-quest-jump-btn span {
    display: inline-block;
    transform: skewX(12deg);
  }

  .p4-quest-jump-btn:hover {
    background-color: #fff;
  }

  /* Paleta naranja característica de menús secundarios de P4 */
  .text-orange { color: var(--color-orange) !important; }

  /* Grid de misiones */
  .p4-quests-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

</style>