---
import Layout from '@layouts/Layout.astro';
import { useTranslations, getMidnightChannelList } from '@i18n/utils';
import type { DefaultParams, P4MidnightChannel } from '@types2/p4';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  // Recorremos los idiomas cargando de forma asíncrona sus respectivos archivos independientes
  for (const lang of languages) {
    const list = await getMidnightChannelList(lang);
    
    list.forEach((channel) => {
      paths.push({
        params: { lang, target: channel.id },
      });
    });
  }

  return paths;
}

const { lang } = Astro.params as DefaultParams;
const { name, airDate, image, broadcastSummary } = Astro.props as P4MidnightChannel;

const t = useTranslations(lang);
---

<Layout title={`${name} | Midnight Channel Broadcast`}>
  <Page>
    <HeaderBox
      title={name}
      subtitle={"📍" + airDate}
    />

    <div class="p4-content-box visual-transmission-box">
      <!-- Simulación de la televisión de P4 a pantalla completa -->
      <div class="p4-fullscreen-tv">
        <div class="p4-crt-scanlines"></div>
        <div class="p4-crt-static-layer anim-heavy"></div>
        <img src={image} alt={name} class="p4-broadcast-full-img" />
      </div>

      <div class="p4-transmission-details" style="margin-top: 2rem;">
        <h3 style="color: #ff00ff; font-family: 'Impact', sans-serif;">
          {t("midnight_channel.[target].dossier")}
        </h3>
        <p class="p4-description" style="font-size: 1.2rem; line-height: 1.8;">
          {broadcastSummary}
        </p>
      </div>
    </div>

    <NavButton lang={lang} route='/midnight-channel'>
      {t("midnight_channel.[target].back")} 
    </NavButton>
  </Page>
</Layout>
