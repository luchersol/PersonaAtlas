---
import Layout from '@layouts/Layout.astro';
import { useTranslations, getP4Data, getMidnightChannelList } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import TvMonitor from '@components/TvMonitor.astro';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';


export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;

const t = useTranslations(lang);

// Cargamos los datos del idioma correspondiente de forma asíncrona
const mcList = await getMidnightChannelList(lang);

const info = await getP4Data(lang, 'midnight-channel');

if (!info) {
  throw new Error(`Data missing for velvet-room in language: ${lang}`);
}

---
<Layout title={`${info.title} | Persona 4 Hub`}>
  <Page>
    <HeaderBox {...info} />

    <section class="p4-mc-section">
      <h2 class="p4-title sub text-magenta">
        <!-- TODO: cambiar a traductor -->
        {lang === 'es' ? 'Transmisiones de Medianoche' : 'Midnight Broadcasts'}
      </h2>
      <div class="p4-tv-grid">
        {mcList.map((tv: any) => (
          <TvMonitor {...tv} />
        ))}
      </div>
    </section>
    <NavButton lang={lang} route='/'>
      {t("nav.back")} 
    </NavButton>
  </Page>
</Layout>


<style>
  
  .p4-mc-section { margin-top: 2rem; }
  .p4-title.sub.text-magenta { color: #fff; text-shadow: 4px 4px 0px #e60012; }
  .p4-tv-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2.5rem;}
</style>