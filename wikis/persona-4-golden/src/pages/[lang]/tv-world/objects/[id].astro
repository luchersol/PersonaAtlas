---
import Layout from '@layouts/Layout.astro';
import { getObjectsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4ObjectEntry } from '@types2/p4';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  for (const lang of languages) {
    const list = await getObjectsList(lang);
    list.forEach((entry) => {
      paths.push({ params: { id: entry.id, lang }, props: { objectEntry: entry } });
    });
  }

  return paths;
}

interface Props {
  objectEntry: P4ObjectEntry;
}

const { objectEntry } = Astro.props as Props;
const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
---

<Layout title={`${objectEntry.name} | Persona 4 Hub`}>
  <Page>
    <HeaderBox title={objectEntry.name} subtitle={objectEntry.category}/>

    <div class="p4-content-box border-orange">
      <p class="p4-description">{objectEntry.description}</p>

      <div class="p4-detail-grid">
        <div class="p4-detail-card">
          <h3>{t('tv-world.objects.usage')}</h3>
          <p>{objectEntry.usage}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.objects.source')}</h3>
          <p>{objectEntry.source}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.objects.heal-hp')}</h3>
          <p>{objectEntry.healHp ?? '—'}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.objects.heal-ep')}</h3>
          <p>{objectEntry.healEp ?? '—'}</p>
        </div>
      </div>

      <div class="p4-sidebar-block status">
        <span>{t('tv-world.objects.status')}</span>
        <p>{objectEntry.statusEffect ?? '—'}</p>
      </div>
    </div>

    <NavButton {lang} route='/tv-world'>{t('nav.back')}</NavButton>
  </Page>
</Layout>

<style>
  .border-orange-left { border-left: 8px solid var(--color-orange); padding-left: 1.5rem; }
  .border-orange { border-color: var(--color-orange); }
</style>
