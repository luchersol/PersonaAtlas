---
import Layout from '@layouts/Layout.astro';
import { getObjectsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4ObjectEntry } from '@types2/p4';
import Section from '@components/Section.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';


export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
const objects = await getObjectsList(lang);
---

<Layout title={`${t('tv-world.objects.title')} | Persona 4 Hub`}>
  <Page>
    <header class="p4-page-header">
      <h1 class="p4-title">{t('tv-world.objects.title')}</h1>
      <p class="p4-subtitle">TV World</p>
    </header>

    <Section>
      <table class="p4-table">
        <thead>
          <tr>
            <th>{t('tv-world.objects.title')}</th>
            <th>{t('tv-world.objects.usage')}</th>
            <th>{t('tv-world.objects.source')}</th>
          </tr>
        </thead>
        <tbody>
          {objects.map((entry: P4ObjectEntry) => (
            <tr>
              <td>
                <a href={`/${lang}/tv-world/objects/${entry.id}`} class="p4-link">{entry.name}</a>
                <div class="p4-muted">{entry.category}</div>
              </td>
              <td>{entry.usage}</td>
              <td>{entry.source}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Section>

    <NavButton {lang} route='/tv-world'>{t('nav.back')}</NavButton>
  </Page>
</Layout>

<style>
  .p4-table { width: 100%; border-collapse: collapse; background-color: #111; border: 2px solid #333; }
  .p4-table th, .p4-table td { padding: 0.9rem 1rem; border-bottom: 1px solid #2e2e2e; text-align: left; color: #fff; }
  .p4-table th { background-color: #1a1a1a; color: var(--primary); text-transform: uppercase; }
  .p4-link { color: var(--color-orange); font-weight: 700; text-decoration: none; }
  .p4-link:hover { color: #fff; }
  .p4-muted { color: #8a8a8a; font-size: 0.9rem; margin-top: 0.25rem; }
</style>
