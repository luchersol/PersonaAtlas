---
import type { P4SectionInfo, DefaultParams } from '@types2/p4';

import Layout from '@layouts/Layout.astro';
import { getObjectsList, getP4Data, getTvWorldDungeonsList, getTvWorldShadowsList, useTranslations } from '@i18n/utils';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Section from '@components/Section.astro';
import Page from '@components/Page.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);

const info: P4SectionInfo = await getP4Data(lang, 'tv-world');
const dungeonsList = await getTvWorldDungeonsList(lang);
const shadowsList = await getTvWorldShadowsList(lang);
const objectsList = await getObjectsList(lang);

if (!info) {
  throw new Error(`Data missing for tv-world in language: ${lang}`);
}

const cards = [
  {
    href: `/${lang}/tv-world/dungeons`,
    title: t('tv-world.dungeons.title'),
    description: 'Accede al listado de mazmorras y sus datos básicos.'
  },
  {
    href: `/${lang}/tv-world/shadows`,
    title: t('tv-world.shadows.title'),
    description: 'Explora las sombras y sus detalles principales.'
  },
  {
    href: `/${lang}/tv-world/objects`,
    title: t('tv-world.objects.title'),
    description: 'Consulta los objetos disponibles en el mundo TV.'
  }
];

---

<Layout title={`${info.title} | Persona 4 Hub`}>
  <Page>
    <HeaderBox {...info} />

    <Section>
      <div class="p4-grid">
        {cards.map((card) => (
          <a href={card.href} class="p4-info-card p4-card-link">
            <div class="p4-card-head">
              <h3>{card.title}</h3>
              <span class="p4-chip">TV</span>
            </div>
            <p>{card.description}</p>
          </a>
        ))}
      </div>
    </Section>

    <NavButton lang={lang} route="/">{t("nav.back")}</NavButton>
  </Page>
</Layout>

<style>
  .p4-card-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .p4-card-head h3 { color: #fff; font-size: 1.1rem; }
  .p4-chip { background-color: var(--color-orange); color: var(--background); padding: 0.2rem 0.45rem; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; }
</style>