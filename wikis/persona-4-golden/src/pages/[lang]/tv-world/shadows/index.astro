---
import Layout from '@layouts/Layout.astro';
import { getTvWorldShadowsList, useTranslations } from '@i18n/utils';
import type { Params } from '@types2/p4';
import type { P4ShadowEntry } from '@types2/p4';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as Params;
const t = useTranslations(lang);
const shadows = await getTvWorldShadowsList(lang);
---

<Layout title={`${t('tv-world.shadows.title')} | Persona 4 Hub`}>
  <article class="p4-card-container">
    <header class="p4-page-header">
      <h1 class="p4-title">{t('tv-world.shadows.title')}</h1>
      <p class="p4-subtitle">TV World</p>
    </header>

    <section class="p4-section">
      <table class="p4-table">
        <thead>
          <tr>
            <th>{t('tv-world.shadows.title')}</th>
            <th>{t('tv-world.shadows.dungeon')}</th>
            <th>{t('tv-world.shadows.reward')}</th>
          </tr>
        </thead>
        <tbody>
          {shadows.map((entry: P4ShadowEntry) => (
            <tr>
              <td>
                <a href={`/${lang}/tv-world/shadows/${entry.id}`} class="p4-link">{entry.name}</a>
                <div class="p4-muted">{entry.weakness}</div>
              </td>
              <td>{entry.dungeon}</td>
              <td>{entry.reward}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <a href={`/${lang}/tv-world`} class="p4-back-btn"><span>{t('nav.back')}</span></a>
  </article>
</Layout>

<style>
  .p4-card-container { display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem; }
  .p4-page-header { border-left: 8px solid #FFEB3B; padding-left: 1.5rem; }
  .p4-subtitle { font-size: 1.2rem; color: #FFEB3B; text-transform: uppercase; font-weight: 700; margin-top: -0.5rem; }
  .p4-section { overflow-x: auto; }
  .p4-table { width: 100%; border-collapse: collapse; background-color: #111; border: 2px solid #333; }
  .p4-table th, .p4-table td { padding: 0.9rem 1rem; border-bottom: 1px solid #2e2e2e; text-align: left; color: #fff; }
  .p4-table th { background-color: #1a1a1a; color: #FFEB3B; text-transform: uppercase; }
  .p4-link { color: #FF9800; font-weight: 700; text-decoration: none; }
  .p4-link:hover { color: #fff; }
  .p4-muted { color: #8a8a8a; font-size: 0.9rem; margin-top: 0.25rem; }
  .p4-back-btn { align-self: flex-start; background-color: #333; color: #fff; padding: 0.6rem 1.5rem; font-weight: 700; text-transform: uppercase; text-decoration: none; transform: skewX(-12deg); border: 2px solid #444; }
  .p4-back-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-back-btn:hover { background-color: #fff; color: var(--background); border-color: #fff; }
</style>
