---
import Layout from '@layouts/Layout.astro';
import { getTvWorldShadowsList, useTranslations } from '@i18n/utils';
import type { Params } from '@types2/p4';
import type { P4ShadowEntry } from '@types2/p4';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  for (const lang of languages) {
    const list = await getTvWorldShadowsList(lang);
    list.forEach((entry) => {
      paths.push({ params: { id: entry.id, lang }, props: { shadow: entry } });
    });
  }

  return paths;
}

interface Props {
  shadow: P4ShadowEntry;
}

const { shadow } = Astro.props as Props;
const { lang } = Astro.params as Params;
const t = useTranslations(lang);
---

<Layout title={`${shadow.name} | Persona 4 Hub`}>
  <article class="p4-card-container">
    <header class="p4-page-header border-orange-left">
      <h1 class="p4-title">{shadow.name}</h1>
      <p class="p4-subtitle">{shadow.dungeon}</p>
    </header>

    <div class="p4-content-box border-orange">
      <p class="p4-description">{shadow.description}</p>

      <div class="p4-detail-grid">
        <div class="p4-detail-card">
          <h3>{t('tv-world.shadows.weaknesses')}</h3>
          <p>{shadow.weaknesses?.join(', ') ?? shadow.weakness}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.shadows.hp')}</h3>
          <p>{shadow.hp ?? '—'}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.shadows.ep')}</h3>
          <p>{shadow.ep ?? '—'}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.shadows.abilities')}</h3>
          <p>{shadow.abilities?.join(', ') ?? '—'}</p>
        </div>
      </div>

      <div class="p4-sidebar-block reward">
        <span>{t('tv-world.shadows.reward')}</span>
        <p>{shadow.reward}</p>
      </div>
    </div>

    <a href={`/${lang}/tv-world`} class="p4-back-btn"><span>{t('nav.back')}</span></a>
  </article>
</Layout>

<style>
  .border-orange-left { border-left: 8px solid #FF9800; padding-left: 1.5rem; }
  .border-orange { border-color: #FF9800; }
  .p4-card-container { display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem; }
  .p4-page-header { border-left: 8px solid #FFEB3B; padding-left: 1.5rem; }
  .p4-subtitle { font-size: 1.2rem; color: #FFEB3B; text-transform: uppercase; font-weight: 700; margin-top: -0.5rem; }
  .p4-content-box { background-color: #000; border: 3px solid #333; padding: 2.5rem; box-shadow: 8px 8px 0px 0px #000; }
  .p4-description { font-size: 1.15rem; line-height: 1.8; color: #e0e0e0; }
  .p4-detail-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem; margin-top: 1.5rem; }
  .p4-detail-card { background-color: #111; border: 1px solid #333; padding: 1rem; }
  .p4-detail-card h3 { color: #FF9800; margin-bottom: 0.4rem; font-size: 0.95rem; text-transform: uppercase; }
  .p4-detail-card p { color: #fff; line-height: 1.6; }
  .p4-sidebar-block { margin-top: 1.5rem; padding: 1rem; background-color: #1a1a1a; border-left: 4px solid #FFEB3B; }
  .p4-sidebar-block span { color: #888; text-transform: uppercase; font-size: 0.75rem; }
  .p4-sidebar-block p { color: #fff; margin-top: 0.3rem; }
  .p4-sidebar-block.reward p { color: #FFEB3B; }
  .p4-back-btn { align-self: flex-start; background-color: #333; color: #fff; padding: 0.6rem 1.5rem; font-weight: 700; text-transform: uppercase; text-decoration: none; transform: skewX(-12deg); border: 2px solid #444; }
  .p4-back-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-back-btn:hover { background-color: #fff; color: #000; border-color: #fff; }
</style>
