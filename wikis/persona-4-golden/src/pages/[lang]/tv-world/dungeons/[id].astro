---
import Layout from '@layouts/Layout.astro';
import { getTvWorldDungeonsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4DungeonEntry } from '@types2/p4';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Page from '@components/Page.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  for (const lang of languages) {
    const list = await getTvWorldDungeonsList(lang);
    list.forEach((entry) => {
      paths.push({ params: { id: entry.id, lang }, props: { dungeon: entry } });
    });
  }

  return paths;
}

interface Props {
  dungeon: P4DungeonEntry;
}

const { dungeon } = Astro.props as Props;
const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
---

<Layout title={`${dungeon.name} | Persona 4 Hub`}>
  <Page>
    <HeaderBox
      title={dungeon.name}
      subtitle={dungeon.area}
    />

    <div class="p4-content-box">
      <p class="p4-description">{dungeon.description}</p>
      <div class="p4-detail-grid">
        <div class="p4-detail-card">
          <h3>{t('tv-world.dungeons.floors')}</h3>
          <p>{dungeon.floors}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('tv-world.dungeons.reward')}</h3>
          <p>{dungeon.reward}</p>
        </div>
      </div>
    </div>

    <NavButton lang={lang} route='/tv-world/dungeons'>
      {t('nav.back')}
    </NavButton>
  </Page>
</Layout>
