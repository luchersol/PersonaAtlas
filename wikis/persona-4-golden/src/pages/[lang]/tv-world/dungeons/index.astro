---
import Layout from '@layouts/Layout.astro';
import { getTvWorldDungeonsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4DungeonEntry } from '@types2/p4';
import HeaderBox from '@components/HeaderBox.astro';
import NavButton from '@components/NavButton.astro';
import Section from '@components/Section.astro';
import Page from '@components/Page.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
const dungeons = await getTvWorldDungeonsList(lang);
---

<Layout title={`${t('tv-world.dungeons.title')} | Persona 4 Hub`}>
  <Page>
    <HeaderBox title={t('tv-world.dungeons.title')} subtitle='TV World'/>

    <Section>
      <table class="p4-table">
        <thead>
          <tr>
            <th>{t('tv-world.dungeons.title')}</th>
            <th>{t('tv-world.dungeons.floors')}</th>
            <th>{t('tv-world.dungeons.reward')}</th>
          </tr>
        </thead>
        <tbody>
          {dungeons.map((entry: P4DungeonEntry) => (
            <tr>
              <td>
                <a href={`/${lang}/tv-world/dungeons/${entry.id}`} class="p4-link">{entry.name}</a>
                <div class="p4-muted">{entry.area}</div>
              </td>
              <td>{entry.floors}</td>
              <td>{entry.reward}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Section>

    <NavButton {lang} route='/tv-world'>{t('nav.back')}</NavButton>
  </Page>
</Layout>

<style>
  .p4-table { width: 100%; border-collapse: collapse; background-color: #111; border: 2px solid #333; }
  .p4-table th, .p4-table td { padding: 0.9rem 1rem; border-bottom: 1px solid #2e2e2e; text-align: left; color: #fff; }
  .p4-table th { background-color: #1a1a1a; color: var(--primary); text-transform: uppercase; }
  .p4-link { color: var(--color-orange); font-weight: 700; text-decoration: none; }
  .p4-link:hover { color: #fff; }
  .p4-muted { color: #8a8a8a; font-size: 0.9rem; margin-top: 0.25rem; }

</style>
