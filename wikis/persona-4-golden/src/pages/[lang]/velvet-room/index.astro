---
import Layout from '@layouts/Layout.astro';
import { getCompendiumList, getP4Data, getSkillCardsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import HeaderBox from '@components/HeaderBox.astro';
import type { P4CompendiumEntry, P4SkillCardEntry } from '@types2/p4';
import Page from '@components/Page.astro';
import NavButton from '@components/NavButton.astro';
import Section from '@components/Section.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);

const info = await getP4Data(lang, 'velvet-room');
const compendiumList = await getCompendiumList(lang);
const skillCardsList = await getSkillCardsList(lang);

if (!info) {
  throw new Error(`Data missing for velvet-room in language: ${lang}`);
}
---

<Layout title={`${info.title} | Persona 4 Hub`}>
  <Page>
    <HeaderBox {...info} />

    <Section>
      <div class="p4-grid">
        <a href={`/${lang}/velvet-room/compendium`} class="p4-info-card p4-card-link">
          <div class="p4-card-head">
            <h3>{t('velvet-room.compendium.title')}</h3>
            <span class="p4-chip">VR</span>
          </div>
          <p>Accede al listado del compendio y sus entradas principales.</p>
        </a>

        <a href={`/${lang}/velvet-room/skill-cards`} class="p4-info-card p4-card-link">
          <div class="p4-card-head">
            <h3>{t('velvet-room.skill-cards.title')}</h3>
            <span class="p4-chip">VR</span>
          </div>
          <p>Consulta las tarjetas de habilidad y su información esencial.</p>
        </a>
      </div>
    </Section>

    <NavButton {lang} route='/'>{t("nav.back")}</NavButton>
  </Page>
</Layout>

<style>
  .p4-card-head { display: flex; justify-content: space-between; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .p4-card-head h3 { color: #fff; font-size: 1.1rem; }
  .p4-chip { background-color: var(--color-orange); color: var(--background); padding: 0.2rem 0.45rem; font-size: 0.75rem; text-transform: uppercase; font-weight: 700; }
  .p4-card-meta { margin-top: 0.75rem; padding-top: 0.75rem; border-top: 1px solid #333; }
</style>