---
import Layout from '@layouts/Layout.astro';
import { getCompendiumList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4CompendiumEntry } from '@types2/p4';
import Page from '@components/Page.astro';
import NavButton from '@components/NavButton.astro';
import Section from '@components/Section.astro';
import HeaderBox from '@components/HeaderBox.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
const compendium = await getCompendiumList(lang);
---

<Layout title={`${t('velvet-room.compendium.title')} | Persona 4 Hub`}>
  <Page>
    <HeaderBox 
      title={t('velvet-room.compendium.title')} 
      subtitle='Velvet Room'
    />

    <Section>
      <table class="p4-table" id="compendium-table">
        <thead>
          <tr>
            <th data-sort="arcana">{t('velvet-room.compendium.arcana')}</th>
            <th data-sort="name">{t('velvet-room.compendium.title')}</th>
            <th data-sort="level">{t('velvet-room.compendium.level')}</th>
          </tr>
        </thead>

        <tbody>
          {compendium.map((entry: P4CompendiumEntry) => (
            <tr
              data-arcana={entry.arcana}
              data-name={entry.name}
              data-level={entry.level}
            >
              <td>{entry.arcana}</td>

              <td>
                <a
                  href={`/${lang}/velvet-room/compendium/${entry.slug}`}
                  class="p4-link"
                >
                  {entry.name}
                </a>
              </td>

              <td>{entry.level}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </Section>

    <NavButton {lang} route='/velvet-room/compendium'>{t("nav.back")}</NavButton>
  </Page>
</Layout>

<script>
  const table = document.querySelector("#compendium-table")!;
  const tbody = table.querySelector("tbody")!;
  const headers = table.querySelectorAll("th");

  let currentSort = "arcana";
  let ascending = true;

  function sortTable(key: string, asc = true) {
    const rows = [...tbody.querySelectorAll("tr")];

    rows.sort((a, b) => {
      let av: string | number = a.dataset[key]!;
      let bv: string | number = b.dataset[key]!;

      if (key === "level") {
        av = Number(av);
        bv = Number(bv);
        return asc ? av - bv : bv - av;
      }

      return asc
        ? av.localeCompare(bv)
        : bv.localeCompare(av);
    });

    tbody.append(...rows);
  }

  // Orden inicial
  sortTable("arcana", true);

  headers.forEach((header) => {
    header.style.cursor = "pointer";

    header.addEventListener("click", () => {
      const key = header.dataset.sort!;

      if (currentSort === key) {
        ascending = !ascending;
      } else {
        currentSort = key;
        ascending = true;
      }

      sortTable(key, ascending);
    });
  });
</script>

<style>
  .p4-table { width: 100%; border-collapse: collapse; background-color: #111; border: 2px solid #333; }
  .p4-table th,
  .p4-table td {
    padding: 0.9rem 1rem;
    border-bottom: 1px solid #2e2e2e;
    text-align: left;
    color: #fff;
  }

  .p4-table th {
    background-color: #1a1a1a;
    color: var(--primary);
    text-transform: uppercase;

    cursor: pointer;
    user-select: none;
    transition: background-color .2s ease;
  }

  .p4-table th:hover {
    background-color: rgba(255, 213, 74, .15);
    color: #fff176;
  }
  .p4-link { color: var(--color-orange); font-weight: 700; text-decoration: none; }
  .p4-link:hover { color: #fff; }
  .p4-muted { color: #8a8a8a; font-size: 0.9rem; margin-top: 0.25rem; }

</style>
