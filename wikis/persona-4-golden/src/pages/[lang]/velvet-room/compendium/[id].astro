---
import Layout from "@layouts/Layout.astro";
import { getCompendiumList, useTranslations } from "@i18n/utils";
import type { P4Skill, Params, P4CompendiumEntry } from "@types2/p4";

const affinityOrder = [
  "Physical",
  "Fire",
  "Ice",
  "Elec",
  "Wind",
  "Light",
  "Dark",
];

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ["en", "es"] as const;

  for (const lang of languages) {
    const list = await getCompendiumList(lang);

    list.forEach((entry) => {
      paths.push({
        params: {
          id: entry.slug,
          lang,
        },
        props: {
          entry,
        },
      });
    });
  }

  return paths;
}

interface Props {
  entry: P4CompendiumEntry;
}

const { entry } = Astro.props;
const { lang } = Astro.params as Params;
const t = useTranslations(lang);
---

<Layout title={`${entry.name} | Persona 4 Hub`}>
  <div class="p4-content-box border-orange">
    <div class="p4-persona-layout">
      <div class="p4-persona-main">
        <div class="p4-detail-grid">
          <div class="p4-detail-card">
            <h3>Name</h3>
            <p>{entry.name}</p>
          </div>

          <div class="p4-detail-card">
            <h3>Arcana</h3>
            <p>{entry.arcana}</p>
          </div>

          <div class="p4-detail-card">
            <h3>Level</h3>
            <p>{entry.level}</p>
          </div>
        </div>

        <section class="p4-persona-panel">
          <h3>Stats</h3>

          <div class="p4-detail-grid">
            <div class="p4-detail-card">
              <h3>Strength</h3>
              <p>{entry.stats.St}</p>
            </div>

            <div class="p4-detail-card">
              <h3>Magic</h3>
              <p>{entry.stats.Ma}</p>
            </div>

            <div class="p4-detail-card">
              <h3>Endurance</h3>
              <p>{entry.stats.En}</p>
            </div>

            <div class="p4-detail-card">
              <h3>Agility</h3>
              <p>{entry.stats.Ag}</p>
            </div>

            <div class="p4-detail-card">
              <h3>Luck</h3>
              <p>{entry.stats.Lu}</p>
            </div>
          </div>
        </section>

        <section class="p4-persona-panel wide">
          <h3>Elemental Affinities</h3>

          <div class="p4-affinity-table">
            {
              affinityOrder.map((element) => (
                <div class="p4-affinity-cell">
                  <img
                    src={`/images/elements/${element.toLowerCase()}.svg`}
                    alt={element}
                    class="p4-element-icon"
                  />

                  <img
                    src={`/images/affinity/${entry.affinities[element]?.toLowerCase() ?? "-"}.svg`}
                    alt={entry.affinities[element]}
                    class="p4-affinity-icon"
                  />
                </div>
              ))
            }
          </div>
        </section>

        {
          entry.skills?.length > 0 && (
            <section class="p4-persona-panel wide">
              <h3>Learned Skills</h3>

              <ul class="p4-skill-list">
                {entry.skills.map((skill: P4Skill) => (
                  <li>
                    <span>{skill.name}</span>

                    <strong>Lv. {skill.level}</strong>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </div>

      <aside class="p4-persona-image">
        <div class="image-container">
          <img
            src={`/images/personas/${entry.slug}.webp`}
            alt={entry.name}
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.removeAttribute('hidden');"
          />
          <div class="p4-image-placeholder" style="display: none;">
            No image
          </div>
        </div>
      </aside>
    </div>
  </div>

  <a href={`/${lang}/velvet-room/compendium`} class="p4-back-btn">
    <span>{t("nav.back")}</span>
  </a>
</Layout>


<style>

.p4-affinity-table{
    display:grid;
    grid-template-columns:repeat(9,1fr);
    gap:.5rem;
    background:#151515;
    border:2px solid #ffd54a;
    border-radius:10px;
    overflow:hidden;
}

.p4-affinity-cell{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:1rem .5rem;
    background:#202020;
    border-right:1px solid rgba(255,255,255,.08);
}

.p4-affinity-cell:last-child{
    border-right:none;
}

.p4-element-icon{
    width:32px;
    height:32px;
    margin-bottom:.6rem;
}

.p4-affinity-icon{
    width:28px;
    height:28px;
}

.p4-stats{
    display:grid;
    grid-template-columns:repeat(5,1fr);
    gap:12px;
}

.p4-stat{
    background:#242424;
    border:1px solid #444;
    border-radius:8px;
    text-align:center;
    padding:12px;
}

.p4-stat h4{
    font-size:.8rem;
    color:#ffd54a;
    margin-bottom:6px;
}

.p4-stat span{
    font-size:1.8rem;
    font-weight:bold;
}

.p4-persona-panel{

    background:#181818;

    border:2px solid #f2c94c;

    border-radius:12px;

    padding:1.5rem;

    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.04),
        0 6px 18px rgba(0,0,0,.35);
}

.p4-persona-image{

    background:#1b1b1b;

    border:2px solid #ffd54a;

    border-radius:12px;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:2rem;

    min-height:420px;
}

.p4-persona-image img{

    max-width:100%;

    max-height:420px;

    object-fit:contain;
}

.p4-skill-list{

    list-style:none;

    margin:0;

    padding:0;
}

.p4-skill-list li{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:.8rem 1rem;

    border-bottom:1px solid rgba(255,255,255,.08);
}

.p4-skill-list li:nth-child(even){

    background:#222;
}

.p4-skill-list strong{

    color:#ffd54a;
}

.aff-wk{
    color:#ff5b5b;
}

.aff-rs{
    color:#6bd26b;
}

.aff-nu{
    color:#62b4ff;
}

.aff-rp{
    color:#d56cff;
}

.aff-dr{
    color:#ffd54a;
}

</style>