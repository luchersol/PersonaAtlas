---
import Layout from "@layouts/Layout.astro";
import { getCompendiumList, useTranslations } from "@i18n/utils";
import type { P4Skill, Params, P4CompendiumEntry } from "@types2/p4";

const affinityOrder = [
  "Physical",
  "Fire",
  "Ice",
  "Elec",
  "Wind",
  "Light",
  "Dark",
];

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ["en", "es"] as const;

  for (const lang of languages) {
    const list = await getCompendiumList(lang);

    list.forEach((entry) => {
      paths.push({
        params: {
          id: entry.slug,
          lang,
        },
        props: {
          entry,
        },
      });
    });
  }

  return paths;
}

interface Props {
  entry: P4CompendiumEntry;
}

const { entry } = Astro.props;
const { lang } = Astro.params as Params;
const t = useTranslations(lang);
---

<Layout title={`${entry.name} | Persona 4 Hub`}>
  <div class="p4-persona-layout">
    <section class="p4-header">
      <div class="p4-summary">
        <div class="image-container">
          <img
            src={`/images/personas/${entry.slug}.webp`}
            alt={entry.name}
            loading="lazy"
            onerror="this.style.display='none'; this.nextElementSibling.removeAttribute('hidden');"
          />

          <div class="p4-image-placeholder" hidden>
            No image
          </div>
        </div>

        <h1>{entry.name}</h1>

        <p class="meta">{entry.arcana}</p>
        <p class="meta">Lv. {entry.level}</p>
      </div>

      <div class="p4-details">

        <section class="p4-persona-panel">

          <div class="p4-affinity-table">
            {
              affinityOrder.map((element) => (
                <div class="p4-affinity-cell">
                  <img
                    src={`/images/elements/${element.toLowerCase()}.svg`}
                    alt={element}
                    class="p4-element-icon"
                  />

                  <img
                    src={`/images/affinity/${entry.affinities[element]?.toLowerCase() ?? "-"}.svg`}
                    alt={entry.affinities[element]}
                    class="p4-affinity-icon"
                  />
                </div>
              ))
            }
          </div>
        </section>

        <section class="p4-persona-panel">

          <div class="p4-stats">
            {[
              ["Strength", entry.stats.St],
              ["Magic", entry.stats.Ma],
              ["Endurance", entry.stats.En],
              ["Agility", entry.stats.Ag],
              ["Luck", entry.stats.Lu],
            ].map(([name, value]) => (
              <div class="p4-stat-row">
                <span>{name}</span>

                <div class="bar">
                  <div
                    class="fill"
                    style={`width:${value}%`}
                  />
                </div>

                <strong>{value}</strong>
              </div>
            ))}
          </div>
        </section>

      </div>
    </section>


    {
      entry.skills?.length > 0 && (
        <section class="p4-persona-panel">
          <h3>Learned Skills</h3>

          <ul class="p4-skill-list">
            {entry.skills.map((skill: P4Skill) => (
              <li>
                <span>{skill.name}</span>
                <strong>Lv. {skill.level}</strong>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <div class="p4-actions">
    <a href={`/${lang}/velvet-room/compendium`} class="p4-back-btn">
      <span>{t("nav.back")}</span>
    </a>
  </div>
</Layout>


<style>

.p4-actions {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255,255,255,.08);
}

.p4-affinity-table {
    display: grid;
    grid-template-columns: repeat(7, 1fr); /* o 9 si tienes 9 elementos */
    gap: .75rem;
}

.p4-affinity-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: .5rem;

    padding: .75rem;

    background: #202020;
    border: 2px solid #ffd54a;
    border-radius: 10px;
}

.p4-element-icon{
    width:32px;
    height:32px;
    margin-bottom:.6rem;
}

.p4-affinity-icon{
    width:28px;
    height:28px;
}

.p4-stats {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.p4-stat-row {
  display: grid;
  grid-template-columns: 110px 1fr 40px;
  align-items: center;
  gap: 12px;
}

.p4-stat-row .label {
  font-weight: 600;
}

.p4-stat-row .bar {
  height: 10px;
  background: #242424;
  border-radius: 999px;
  overflow: hidden;
}

.p4-stat-row .fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #f7d44a, #ff8b3d);
}

.p4-persona-panel{
    background:#181818;
    border:2px solid #f2c94c;
    border-radius:12px;
    padding:1.5rem;
    box-shadow:
        inset 0 0 0 1px rgba(255,255,255,.04),
        0 6px 18px rgba(0,0,0,.35);
}

.p4-persona-image{

    background:#1b1b1b;

    border:2px solid #ffd54a;

    border-radius:12px;

    display:flex;

    justify-content:center;

    align-items:center;

    padding:2rem;

    min-height:420px;
}

.p4-persona-image img{

    max-width:100%;

    max-height:420px;

    object-fit:contain;
}

.p4-skill-list{

    list-style:none;

    margin:0;

    padding:0;
}

.p4-skill-list li{

    display:flex;

    justify-content:space-between;

    align-items:center;

    padding:.8rem 1rem;

    border-bottom:1px solid rgba(255,255,255,.08);
}

.p4-skill-list li:nth-child(even){

    background:#222;
}

.p4-skill-list strong{

    color:#ffd54a;
}

.aff-wk{
    color:#ff5b5b;
}

.aff-rs{
    color:#6bd26b;
}

.aff-nu{
    color:#62b4ff;
}

.aff-rp{
    color:#d56cff;
}

.aff-dr{
    color:#ffd54a;
}

.p4-header {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 2rem;
  align-items: start;
}

.p4-summary {
  background:#181818;
  border:2px solid #f2c94c;
  border-radius:12px;
  padding:1.5rem;
  box-shadow:
      inset 0 0 0 1px rgba(255,255,255,.04),
      0 6px 18px rgba(0,0,0,.35);

  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 1.5rem;
}

.p4-summary h1 {
  margin: 0;
  font-size: 2rem;
}

.p4-summary .meta {
  color: var(--text-muted);
  margin: 0;
}

.p4-summary .level {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  padding: .4rem .8rem;
  border-radius: 999px;

  background: var(--accent);
  color: #fff;
  font-weight: 700;
}

.image-container {
  width: 180px;
  height: 180px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 1rem;
  border-radius: 10px;

  background:
    radial-gradient(circle at center,
      #355f9d 0%,
      #243f69 55%,
      #16253f 100%);

  border: 1px solid rgba(255,255,255,.08);
}

.image-container img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.p4-details {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.p4-back-btn {
    align-self: flex-start;

    margin-top: 2rem;

    background-color: #333;
    color: #fff;
    padding: 0.6rem 1.5rem;

    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;

    transform: skewX(-12deg);

    border: 2px solid #444;

    transition: background-color .2s, color .2s, border-color .2s;
}

.p4-back-btn span {
    display: inline-block;
    transform: skewX(12deg);
}

.p4-back-btn:hover {
    background-color: #fff;
    color: var(--background);
    border-color: #fff;
}

</style>