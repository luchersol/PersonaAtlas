---
import Layout from '@layouts/Layout.astro';
import SkillCardVisual from '@components/SkillCardVisual.astro';
import { getSkillCardsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4SkillCardEntry } from '@types2/p4';
import Page from '@components/Page.astro';
import NavButton from '@components/NavButton.astro';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  for (const lang of languages) {
    const list = await getSkillCardsList(lang);
    list.forEach((entry) => {
      paths.push({ params: { id: entry.id, lang }, props: { entry } });
    });
  }

  return paths;
}

interface Props {
  entry: P4SkillCardEntry;
}

const { entry } = Astro.props as Props;
const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
---

<Layout title={`${entry.name} | Persona 4 Hub`}>
  <Page>
    <header class="p4-page-header border-orange-left">
      <h1 class="p4-title">{entry.name}</h1>
      <p class="p4-subtitle">{t('velvet-room.skill-cards.title')}</p>
    </header>

    <div class="p4-content-box border-orange">
      <SkillCardVisual entry={entry} />

      <div class="p4-detail-grid">
        <div class="p4-detail-card">
          <h3>{t('velvet-room.skill-cards.effect')}</h3>
          <p>{entry.effect}</p>
        </div>
        <div class="p4-detail-card">
          <h3>{t('velvet-room.skill-cards.source')}</h3>
          <p>{entry.source}</p>
        </div>
      </div>
    </div>

    <NavButton {lang} route='/velvet-room'>{t("nav.back")}</NavButton>
  </Page>
</Layout>

<style>
  .border-orange-left { border-left: 8px solid var(--color-orange); padding-left: 1.5rem; }
  .border-orange { border-color: var(--color-orange); }
  
  
  
  
  


</style>
