---
import Layout from '@layouts/Layout.astro';
import SkillCardVisual from '@components/SkillCardVisual.astro';
import { getSkillCardsList, useTranslations } from '@i18n/utils';
import type { DefaultParams } from '@types2/p4';
import type { P4SkillCardEntry } from '@types2/p4';
import Page from '@components/Page.astro';
import HeaderBox from '@components/HeaderBox.astro';
import Section from '@components/Section.astro';
import NavButton from '@components/NavButton.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as DefaultParams;
const t = useTranslations(lang);
const skillCards = await getSkillCardsList(lang);
---

<Layout title={`${t('velvet-room.skill-cards.title')} | Persona 4 Hub`}>
  <Page>
    <HeaderBox 
      title={t('velvet-room.skill-cards.title')}
      subtitle='Velvet Room'
    />

    <Section>
      <div class="p4-skill-list">
        {skillCards.map((entry: P4SkillCardEntry) => (
          <a href={`/${lang}/velvet-room/skill-cards/${entry.id}`} class="p4-skill-card-link">
            <SkillCardVisual entry={entry} compact />
          </a>
        ))}
      </div>
    </Section>

    <NavButton {lang} route='/velvet-room'>{t("nav.back")}</NavButton>
  </Page>
</Layout>

<style>
  .p4-skill-list { display: grid; gap: 1rem; }
  .p4-skill-card-link { color: inherit; text-decoration: none; }
</style>
