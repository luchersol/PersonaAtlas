---
// src/components/LangSelector.astro

// 1. Obtenemos la URL actual procesada en el servidor
const { pathname } = Astro.url;

// 2. Desestructuramos la ruta para identificar el idioma y el destino actual
// Si estás en "/es/articulos/persona-3", segmentos será ["", "es", "articulos", "persona-3"]
const segmentos = pathname.split('/');
const currentLang = segmentos[1] || 'es'; 
const restoDeLaRuta = segmentos.slice(2).join('/'); 

// 3. Helper para recalcular la ruta exacta cambiando únicamente el prefijo de idioma
const getLangPath = (targetLang: string) => {
  return `/${targetLang}/${restoDeLaRuta}`;
};
---

<div class="lang-selector">
  <a 
    href={getLangPath('es')} 
    class={currentLang === 'es' ? 'active' : ''}
  >
    <span>ES</span>
  </a>
  <a 
    href={getLangPath('en')} 
    class={currentLang === 'en' ? 'active' : ''}
  >
    <span>EN</span>
  </a>
</div>

<style>
  /* CONTAINER DEL SELECTOR DE IDIOMA */
  .lang-selector {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    gap: 10px;
    z-index: 100;
    font-family: 'Impact', 'Arial Black', sans-serif;
  }

  /* ENLACE DE IDIOMA BASE (Adaptado con tus propiedades estéticas de P3R) */
  .lang-selector a {
    display: inline-block;
    background-color: #000;
    color: #FFFFFF;
    text-decoration: none;
    font-size: 1.1rem;
    font-weight: 900;
    padding: 6px 16px;
    border: 3px solid #000;
    transform: skewX(-15deg);
    box-shadow: 4px 4px 0px #333333;
    transition: all 0.15s ease-in-out;
    cursor: pointer;
    letter-spacing: 1px;
  }

  /* ESTADO EN FOCUS O HOVER */
  .lang-selector a:hover {
    background-color: #FFFFFF;
    color: #000;
    border-color: #FFFFFF;
    box-shadow: 4px 4px 0px #000;
    transform: skewX(-15deg) scale(1.05);
  }

  /* IDIOMA ACTIVO */
  .lang-selector a.active {
    background-color: var(--primary); /* Púrpura de Persona 3 Reload */
    color: #FFFFFF;
    border-color: var(--primary);
    box-shadow: 5px 5px 0px #000;
    animation: p3r-pulse 1.5s infinite alternate ease-in-out;
  }

  /* Ajuste de alineación del texto */
  .lang-selector a span, 
  .lang-selector a {
    text-align: center;
  }

  /* ANIMACIÓN DE PARPADEO SUTIL PARA EL IDIOMA ACTIVO */
  @keyframes p3r-pulse {
    0% {
      box-shadow: 4px 4px 0px #000;
      filter: brightness(1);
    }
    100% {
      box-shadow: 7px 7px 0px #5a2f7f; /* Sombra púrpura más oscura */
      filter: brightness(1.15);
    }
  }

  /* ADAPTACIÓN PARA DISPOSITIVOS MÓVILES */
  @media (max-width: 600px) {
    .lang-selector {
      top: 10px;
      right: 10px;
      gap: 8px;
    }

    .lang-selector a {
      font-size: 0.9rem;
      padding: 4px 12px;
    }
  }
</style>
