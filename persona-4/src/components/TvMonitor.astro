---
import type { Params } from '@types2/p4';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as Params;

interface Props {
    image: string, 
    name: string, 
    status: string, 
    airDate: string, 
    broadcastSummary: string, 
    href: string
}

const {image, name, status, airDate, broadcastSummary, href} = Astro.props;
---
<div class="p4-tv-monitor">
    <div class="p4-crt-screen">
        <div class="p4-crt-scanlines"></div>
        <div class="p4-crt-static-layer"></div>
        <img src={image} alt={name} class="p4-tv-image" onerror="this.style.opacity='0.1'" />
        <span class={status.includes('Deceased') || status.includes('Fallecido') ? 'p4-tv-status dead' : 'p4-tv-status alert'}>
        {status}
        </span>
    </div>
    <div class="p4-tv-bezel">
        <div class="p4-tv-meta">
        <h3>{name}</h3>
        <p class="p4-broadcast-time">📺 {airDate}</p>
        <p class="p4-broadcast-desc">{broadcastSummary}</p>
        </div>
        <!-- Acoplamos el parámetro de idioma a la transmisión individual -->
        <a href={href} class="p4-tune-btn">
        <span>{lang === 'es' ? 'Sintonizar Canal' : 'Tune Channel'}</span>
        </a>
    </div>
</div>

<style>
      /* El mueble de la televisión antigua */
  .p4-tv-monitor {
    background-color: #0e0e0e;
    border: 4px solid #000;
    box-shadow: 6px 6px 0px #FFEB3B;
    display: flex;
    flex-direction: column;
    border-radius: 8px;
    overflow: hidden;
  }

  /* Pantalla de Cristal (CRT) */
  .p4-crt-screen {
    background-color: #151815;
    height: 180px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 4px solid #000;
  }

  .p4-tv-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.3) saturate(1.4) hue-rotate(-20deg); /* Efecto vintage amarillo/verdoso */
    transition: opacity 0.3s ease;
  }

  /* Efecto líneas de escaneo de TV vieja */
  .p4-crt-scanlines {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 3;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
    background-size: 100% 4px, 6px 100%;
  }

  /* Capa de nieve/estática animada de TV sin señal */
  .p4-crt-static-layer {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    z-index: 2;
    background-image: repeating-radial-gradient(circle at 50% 50%, #fff 0px, #fff 1px, transparent 1px, transparent 100%);
    background-size: 8px 8px;
    animation: tvNoise 0.1s infinite;
  }

  @keyframes tvNoise {
    0% { transform: translate(0, 0); }
    100% { transform: translate(-2px, 2px); }
  }

  /* Badges de Estado */
  .p4-tv-status {
    position: absolute;
    bottom: 8px;
    left: 8px;
    font-size: 0.75rem;
    font-weight: 900;
    padding: 2px 6px;
    text-transform: uppercase;
    z-index: 4;
  }
  .p4-tv-status.dead { background-color: #e60012; color: #fff; }
  .p4-tv-status.alert { background-color: #FFEB3B; color: #000; animation: pulse 1s infinite alternate; }

  @keyframes pulse { from { opacity: 0.6; } to { opacity: 1; } }

  /* Controles e Información Inferior */
  .p4-tv-bezel {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    background-color: #1a1a1a;
  }
  .p4-tv-meta h3 {
    font-family: 'Impact', sans-serif;
    font-size: 1.4rem;
    color: #fff;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .p4-broadcast-time {
    color: #FFEB3B;
    font-size: 0.85rem;
    font-weight: 700;
    margin: 0.25rem 0 0.75rem 0;
  }
  .p4-broadcast-desc {
    color: #999;
    font-size: 0.9rem;
    line-height: 1.4;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  
  /* Botón Sintonizar */
  .p4-tune-btn {
    background-color: #000;
    color: #FFEB3B;
    text-align: center;
    padding: 0.5rem;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: none;
    transform: skewX(-10deg);
    border: 2px solid #FFEB3B;
    transition: all 0.2s;
  }
  .p4-tune-btn span { display: inline-block; transform: skewX(10deg); }
  .p4-tune-btn:hover { background-color: #FFEB3B; color: #000; }
</style>