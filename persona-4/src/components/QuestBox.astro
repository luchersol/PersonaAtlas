---
import type { P4Language, Params } from '@types2/p4';

interface Props {
    id: number;
    name: string; 
    title: string;
    day: string;
    client: string; 
    location: string;
};

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as Params;

const {id, name, title, day, client, location} = Astro.props;
---
<div class="p4-quest-item">
    <div class="p4-quest-header">
        <span class="p4-quest-number">{name}</span>
        <span class={"p4-quest-day"}>{day}</span>
    </div>
    <h3 class="p4-quest-title">{title}</h3>
    <div class="p4-quest-meta">
        <p>👤 <strong>Client:</strong> {client}</p>
        <p>📍 <strong>Location:</strong> {location}</p>
    </div>
    <a href={`/${lang}/quests/${id}`} class="p4-view-quest-btn"><span>View Details</span></a>
</div>

<style>
    .p4-quest-item {
    background-color: #111;
    border: 2px solid #333;
    padding: 1.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .p4-quest-item:hover {
    border-color: #FF9800;
  }

  .p4-quest-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .p4-quest-number {
    font-family: 'Impact', sans-serif;
    color: #FF9800;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .p4-quest-day {
    padding: 2px 10px;
    font-size: 0.8rem;
    background-color: #9e9e9e; 
    color: #fff; 
    text-transform: uppercase;
    font-weight: bold;
    transform: skewX(-10deg);´
  }

  .p4-quest-title {
    font-size: 1.4rem;
    color: #fff;
    margin: 0.2rem 0;
  }

  .p4-quest-meta p {
    font-size: 0.95rem;
    color: #aaa;
    margin: 0.2rem 0;
  }

  .p4-view-quest-btn {
    align-self: flex-end;
    background-color: #FF9800;
    color: #000;
    text-decoration: none;
    font-weight: bold;
    padding: 0.4rem 1.2rem;
    text-transform: uppercase;
    font-size: 0.9rem;
    transform: skewX(-12deg);
    margin-top: 0.5rem;
  }
  .p4-view-quest-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-view-quest-btn:hover { background-color: #fff; }
</style>