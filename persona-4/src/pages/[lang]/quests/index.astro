---
import type { P4Quest } from '@types/p4.ts';

import Layout from '@layouts/Layout.astro';
import { useTranslations, getP4Data, getQuestsList } from '@i18n/utils';
import type { Params } from '@types/p4';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } }, 
    { params: { lang: 'en' } }
  ];
}

const { lang } = Astro.params as Params;

const t = useTranslations(lang);

// ⚡️ ¡Simplemente añadimos await a las llamadas!
const questsList = await getQuestsList(lang);

const info = await getP4Data(lang, 'quests');

if (!info) {
  throw new Error(`Data missing for velvet-room in language: ${lang}`);
}

---
<Layout title={`${info.title} | Persona 4 Hub`}>
  <article class="p4-card-container">
    <header class="p4-page-header text-orange">
      <h1 class="p4-title">{info.title}</h1>
      <p class="p4-subtitle">{info.subtitle}</p>
    </header>

    <div class="p4-content-box">
      <p class="p4-description">{info.description}</p>
      <div class="p4-mechanic-box">
        <span class="p4-badge">SYSTEM_NOTE</span>
        <p>{info.mechanic}</p>
      </div>
    </div>

    <section class="p4-quests-section">
      <h2 class="p4-title sub text-orange">Bulletin Board</h2>
      <div class="p4-quests-list">
        {questsList.map((quest: P4Quest) => (
          <div class="p4-quest-item">
            <div class="p4-quest-header">
              <span class="p4-quest-number">{quest.number}</span>
              <span class={`p4-quest-status ${quest.status.toLowerCase().replace(' ', '-')}`}>
                {quest.status}
              </span>
            </div>
            <h3 class="p4-quest-title">{quest.title}</h3>
            <div class="p4-quest-meta">
              <p>👤 <strong>Client:</strong> {quest.client}</p>
              <p>📍 <strong>Location:</strong> {quest.location}</p>
            </div>
            <a href={`/quests/${quest.id}`} class="p4-view-quest-btn"><span>View Details</span></a>
          </div>
        ))}
      </div>
    </section>

    <a href="/" class="p4-back-btn"><span>Go back to Inaba</span></a>
  </article>
</Layout>

<style>

<style>
  /* Aquí van los estilos base que ya teníamos para tarjetas compartidas */
  .p4-card-container { display: flex; flex-direction: column; gap: 2rem; margin-top: 2rem; }
  .p4-page-header { border-left: 8px solid #FFEB3B; padding-left: 1.5rem; }
  .p4-subtitle { font-size: 1.2rem; color: #FFEB3B; text-transform: uppercase; font-weight: 700; margin-top: -0.5rem; }
  .p4-content-box { background-color: #000; border: 3px solid #333; padding: 2.5rem; box-shadow: 8px 8px 0px 0px #000; }
  .p4-description { font-size: 1.15rem; line-height: 1.8; color: #e0e0e0; }
  .p4-mechanic-box { margin-top: 2rem; background-color: #222; border-left: 5px solid #FFEB3B; padding: 1.5rem; position: relative; }
  .p4-badge { position: absolute; top: -12px; left: 15px; background-color: #FFEB3B; color: #000; font-family: 'Impact', sans-serif; padding: 2px 8px; font-size: 0.85rem; transform: skewX(-10deg); }
  .p4-mechanic-box p { font-size: 1rem; color: #FFEB3B; font-style: italic; }
  .p4-back-btn { align-self: flex-start; background-color: #333; color: #fff; padding: 0.6rem 1.5rem; font-weight: 700; text-transform: uppercase; text-decoration: none; transform: skewX(-12deg); border: 2px solid #444; }
  .p4-back-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-back-btn:hover { background-color: #fff; color: #000; border-color: #fff; }


  .p4-quests-section {
    margin-top: 2rem;
  }

  /* Paleta naranja característica de menús secundarios de P4 */
  .text-orange { color: #FF9800 !important; }
  .border-orange { border-color: #FF9800 !important; }
  .border-orange-left { border-left-color: #FF9800 !important; }
  .bg-orange { background-color: #FF9800 !important; color: #000 !important; }

  /* Grid de misiones */
  .p4-quests-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .p4-quest-item {
    background-color: #111;
    border: 2px solid #333;
    padding: 1.5rem;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .p4-quest-item:hover {
    border-color: #FF9800;
  }

  .p4-quest-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .p4-quest-number {
    font-family: 'Impact', sans-serif;
    color: #FF9800;
    font-size: 1.2rem;
    letter-spacing: 1px;
  }

  .p4-quest-status {
    padding: 2px 10px;
    font-size: 0.8rem;
    text-transform: uppercase;
    font-weight: bold;
    transform: skewX(-10deg);
  }
  .p4-quest-status.available { background-color: #4CAF50; color: #fff; }
  .p4-quest-status.in-progress { background-color: #FFEB3B; color: #000; }
  .p4-quest-status.completed { background-color: #9e9e9e; color: #fff; }

  .p4-quest-title {
    font-size: 1.4rem;
    color: #fff;
    margin: 0.2rem 0;
  }

  .p4-quest-meta p {
    font-size: 0.95rem;
    color: #aaa;
    margin: 0.2rem 0;
  }

  .p4-view-quest-btn {
    align-self: flex-end;
    background-color: #FF9800;
    color: #000;
    text-decoration: none;
    font-weight: bold;
    padding: 0.4rem 1.2rem;
    text-transform: uppercase;
    font-size: 0.9rem;
    transform: skewX(-12deg);
    margin-top: 0.5rem;
  }
  .p4-view-quest-btn span { display: inline-block; transform: skewX(12deg); }
  .p4-view-quest-btn:hover { background-color: #fff; }
</style>