---
import Layout from '../../layouts/Layout.astro';
import { useTranslations, getMidnightChannelList } from '../../i18n/utils';

export async function getStaticPaths() {
  const paths: any[] = [];
  const languages = ['en', 'es'] as const;

  // Recorremos los idiomas cargando asíncronamente sus listas de canales
  for (const lang of languages) {
    const list = await getMidnightChannelList(lang);
    
    list.forEach((tv: any) => {
      // Extraemos el ID final de la ruta del JSON (ej: 'mayumi-yamano')
      const targetSlug = tv.route.split('/').pop();
      
      paths.push({
        params: { target: targetSlug },
        props: { tv, routeLang: lang },
      });
    });
  }

  return paths;
}

const { tv, routeLang } = Astro.props;
const t = useTranslations(routeLang);
---
<Layout title={`${tv.name} | Midnight Channel Broadcast`}>
  <article class="p4-card-container">
    <header class="p4-page-header">
      <h1 class="p4-title">{tv.name}</h1>
      <p class="p4-subtitle">📍 {tv.airDate}</p>
    </header>

    <div class="p4-content-box visual-transmission-box">
      <!-- Simulación de la televisión de P4 a pantalla completa -->
      <div class="p4-fullscreen-tv">
        <div class="p4-crt-scanlines"></div>
        <div class="p4-crt-static-layer anim-heavy"></div>
        <img src={tv.image} alt={tv.name} class="p4-broadcast-full-img" />
      </div>

      <div class="p4-transmission-details" style="margin-top: 2rem;">
        <h3 style="color: #ff00ff; font-family: 'Impact', sans-serif;">
          {routeLang === 'es' ? 'INFORME DE LA TRANSMISIÓN' : 'BROADCAST DOSSIER'}
        </h3>
        <p class="p4-description" style="font-size: 1.2rem; line-height: 1.8;">
          {tv.broadcastSummary}
        </p>
      </div>
    </div>

    <!-- Volvemos al tablón manteniendo el idioma de la ruta actual -->
    <a href={`/midnight-channel?lang=${routeLang}`} class="p4-back-btn">
      <span>{routeLang === 'es' ? 'Volver al Tablón' : 'Back to Monitor Board'}</span>
    </a>
  </article>
</Layout>

<style>
  .p4-broadcast-wrapper { margin-top: 1rem; }
  .p4-btn-back-tv { color: #FFEB3B; text-transform: uppercase; font-weight: 700; text-decoration: none; font-size: 0.9rem; display: inline-block; margin-bottom: 1.5rem; }
  .p4-btn-back-tv:hover { text-decoration: underline; }

  .p4-crt-big-monitor {
    background-color: #050505;
    border: 6px solid #000;
    box-shadow: 12px 12px 0px #000;
    display: flex;
    flex-direction: column;
  }

  /* Pantalla gigante */
  .p4-crt-screen-big {
    background-color: #121512;
    height: 350px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 6px solid #000;
  }

  .p4-big-tv-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: sepia(0.4) saturate(1.6) hue-rotate(-30deg) blur(1px); /* Distorsión de silueta */
  }

  /* Efectos CRT Gigantes */
  .p4-scanlines-big {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.4) 50%);
    background-size: 100% 6px;
  }
  .p4-static-big {
    position: absolute; inset: 0; opacity: 0.2; z-index: 2; pointer-events: none;
    background-image: repeating-radial-gradient(circle at 50% 50%, #fff 0px, #fff 1px, transparent 1px, transparent 100%);
    background-size: 6px 6px;
    animation: noiseMove 0.05s infinite;
  }
  .p4-shadow-overlay {
    position: absolute; inset: 0; z-index: 4; pointer-events: none;
    background: radial-gradient(circle, transparent 40%, rgba(0, 0, 0, 0.8) 100%); /* Viñeta oscura */
  }

  @keyframes noiseMove {
    0% { transform: translate(0, 0); }
    100% { transform: translate(3px, -1px); }
  }

  /* Interfaz REC de la tele */
  .p4-rec-indicator {
    position: absolute; top: 20px; left: 20px; z-index: 5;
    display: flex; align-items: center; gap: 8px;
    font-family: monospace; color: #e60012; font-weight: bold; font-size: 0.9rem;
    background: rgba(0,0,0,0.6); padding: 4px 8px;
  }
  .p4-rec-dot {
    width: 10px; height: 10px; background-color: #e60012; border-radius: 50%;
    animation: blink 1s infinite alternate;
  }
  @keyframes blink { from { opacity: 0.2; } to { opacity: 1; } }

  /* Dashboard de Control */
  .p4-tv-dashboard { padding: 2rem; background-color: #111; color: #fff; }
  .p4-dash-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; border-bottom: 2px solid #333; padding-bottom: 1rem; margin-bottom: 1rem; }
  .p4-dash-badge { background-color: #e60012; color: #fff; font-weight: 900; font-size: 0.8rem; padding: 4px 10px; text-transform: uppercase; transform: skewX(-10deg); }
  
  .p4-dash-body { display: grid; grid-template-columns: 1fr; gap: 1.5rem; }
  @media (min-width: 768px) { .p4-dash-body { grid-template-columns: 250px 1fr; } }

  .p4-dash-meta p { font-size: 0.9rem; color: #888; margin-bottom: 0.5rem; }
  .p4-dash-meta strong { color: #FFEB3B; }
  .p4-dash-summary { font-size: 1.1rem; line-height: 1.6; color: #ccc; }
</style>